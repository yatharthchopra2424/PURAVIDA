# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in real values:  cp .env.example .env
#
# This file IS committed — it documents which variables exist.
# It must never contain real keys, passwords, or tokens.
# ─────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────
# Canonical public origin, no trailing slash.
# Local:      http://localhost:3000
# Production: https://www.puravidanaturalindia.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public/anon key. Exposed in the browser bundle by design.
# This is only safe while RLS is enabled on every public table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — bypasses Row Level Security. Server-side only.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin access control ─────────────────────────────────────
# Comma-separated list of emails permitted to reach /x-admin.
# A valid Supabase session alone does NOT grant admin access.
ADMIN_EMAILS=admin@example.com

# ── Email (Resend) ───────────────────────────────────────────
# Optional. If unset, contact submissions are saved to the database
# and logged to the server console instead of emailed.
RESEND_API_KEY=
# Where new-inquiry notifications are sent (your team's inbox).
CONTACT_EMAIL=

# REQUIRED for the customer confirmation email to actually deliver.
# Resend's sandbox sender (onboarding@resend.dev, used when this is
# unset) can only send to the Resend account's own address — it cannot
# reach arbitrary customers. Verify a domain at resend.com/domains,
# then set this to an address on that domain, e.g.:
#   PuraVida Quotes <quotes@puravidanaturalindia.com>
RESEND_FROM=

# ── Search engine ownership verification ────────────────────
# Google Search Console → Settings → Ownership verification → HTML tag
# → copy just the `content` value (not the whole <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Settings → Ownership verification → HTML Meta
# Tag → copy just the `content` value.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Rebuild on catalog change ────────────────────────────────
# Product/category pages use dynamicParams=false so unknown URLs return
# a real 404 instead of a 200. The consequence is that valid paths are
# fixed at build time, so adding a product needs a rebuild. The admin
# routes POST to this hook automatically after any catalog change.
#   Vercel → Settings → Git → Deploy Hooks → Create Hook
# Leave blank locally; nothing breaks, you just don't get auto-rebuilds.
VERCEL_DEPLOY_HOOK_URL=

# ── Rate limiting (optional) ─────────────────────────────────
# Without these the contact form falls back to a per-instance in-memory
# limiter, which is leaky across serverless instances. Free tier is ample.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
