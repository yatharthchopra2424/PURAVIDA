# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in real values:  cp .env.example .env
#
# This file IS committed — it documents which variables exist.
# It must never contain real keys, passwords, or tokens.
# ─────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────
# Canonical public origin, no trailing slash.
# Local:      http://localhost:3000
# Production: https://www.puravidanaturalindia.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public/anon key. Exposed in the browser bundle by design.
# This is only safe while RLS is enabled on every public table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — bypasses Row Level Security. Server-side only.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin access control ─────────────────────────────────────
# Comma-separated list of emails permitted to reach /x-admin.
# A valid Supabase session alone does NOT grant admin access.
ADMIN_EMAILS=admin@example.com

# ── Email: direct SMTP from your own mailbox ─────────────────
# There is no third-party sending API in this project. Quote
# confirmations, admin notifications and bulk outreach campaigns all go
# over one authenticated SMTP connection to the company mailbox, so the
# sending reputation and the recipient data stay with the domain — and
# there is no per-message billing or monthly quota to hit mid-campaign.
#
# Without these the contact form still saves to the database and logs
# the enquiry to the server console; it just cannot email anyone.
#
# Typical values for a domain mailbox:
#   Google Workspace   smtp.gmail.com      587   app password required
#   Zoho Mail          smtp.zoho.in        465   SMTP_SECURE=true
#   Microsoft 365      smtp.office365.com  587
#   cPanel / shared    mail.yourdomain.com 465 or 587
SMTP_HOST=
SMTP_PORT=587
# "true" only for implicit TLS on port 465. Leave blank for 587/STARTTLS.
SMTP_SECURE=
SMTP_USER=
# App-specific password where the provider offers one — never the
# mailbox's own login password.
#
# IMPORTANT: backslash-escape any '$' in the value.  Next.js expands
# .env files with dotenv-expand, so an unescaped $ is read as a variable
# reference and silently removed — the app then fails with "535
# Authentication Failed" using a password that is correct on disk.
# Quoting does NOT help; dotenv strips quotes before expanding.
#   wrong:  SMTP_PASS=abc$def12      -> app receives "abc"
#   right:  SMTP_PASS=abc\$def12     -> app receives "abc$def12"
# In Vercel's dashboard, paste the RAW password with no backslash.
SMTP_PASS=

# The From: address. Its domain needs SPF, DKIM and DMARC records, or
# mail from it lands in spam regardless of what it says. Use an address
# on the same domain as NEXT_PUBLIC_SITE_URL: a From: domain that
# disagrees with the site is itself a spam signal.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=PuraVida Natural
# Where replies land, if not the From: address.
MAIL_REPLY_TO=

# Where new-inquiry notifications are sent (your team's inbox).
CONTACT_EMAIL=

# Prove it all works before relying on it:
#   npm run mail:verify -- --to you@example.com

# ── Search engine ownership verification ────────────────────
# Google Search Console → Settings → Ownership verification → HTML tag
# → copy just the `content` value (not the whole <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Settings → Ownership verification → HTML Meta
# Tag → copy just the `content` value.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Rebuild on catalog change ────────────────────────────────
# Product/category pages use dynamicParams=false so unknown URLs return
# a real 404 instead of a 200. The consequence is that valid paths are
# fixed at build time, so adding a product needs a rebuild. The admin
# routes POST to this hook automatically after any catalog change.
#   Vercel → Settings → Git → Deploy Hooks → Create Hook
# Leave blank locally; nothing breaks, you just don't get auto-rebuilds.
VERCEL_DEPLOY_HOOK_URL=

# ── Rate limiting (optional) ─────────────────────────────────
# Without these the contact form falls back to a per-instance in-memory
# limiter, which is leaky across serverless instances. Free tier is ample.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ═════════════════════════════════════════════════════════════
#  LEAD DATABASE + OUTBOUND CAMPAIGNS
#  Everything below powers /x-admin/leads and /x-admin/campaigns.
#  Put the real values in .env.local (gitignored), not here.
# ═════════════════════════════════════════════════════════════

# ── AI enrichment (NVIDIA NIM) ───────────────────────────────
# Used only by `npm run leads:enrich`, never at request time.
# Key from build.nvidia.com → your profile → API keys.
NVIDIA_API_KEY=
# Optional overrides. The defaults are the ones below.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Campaign dispatcher ──────────────────────────────────────
# Shared secret for /api/cron/dispatch-campaigns, which sends the next
# batch of every active campaign. Without it the route refuses to run,
# so an open endpoint cannot drain a queued campaign.
# Generate one:  openssl rand -hex 32
# Set the same value in the GitHub repo secret CRON_SECRET.
CRON_SECRET=

# Extra hosts campaign links may point at, comma separated. The site's
# own domain is always allowed. Links to any other host are left
# untracked rather than wrapped, so the click redirect can never be
# turned into an open redirect on your domain.
# e.g. CAMPAIGN_LINK_HOSTS=calendly.com,drive.google.com
CAMPAIGN_LINK_HOSTS=
